# Copiar a .env y ajustar. El .env real NUNCA se versiona.
GEPP_BD_URL=postgresql+psycopg://gepp:gepp_dev@localhost:5432/gepp
GEPP_REDIS_URL=redis://localhost:6379/0
# Quién entra a la API: `token=correo,...` (autenticación de demostración, no la de producción).
# Sin definir, entran el prevencionista de demo y las cuentas del equipo (gepp_api.config).
# Fuera del equipo, definirla siempre: el mapa por defecto es público en el repositorio.
GEPP_API_TOKENS=

# Carpeta vigilada. Debe estar en el sistema de archivos de Linux:
# inotify NO funciona sobre /mnt/c en WSL2 — la llamada tiene éxito y nunca llega
# un evento. El sistema rechaza rutas bajo /mnt/ (ver ADR-005).
GEPP_CARPETA_VIGILADA=/datos/videos/entrada
GEPP_CARPETA_EVIDENCIA=/datos/evidencia
# Carpeta de entrada: los videos que se piden procesar desde la web (elige archivo y cámara).
# Opcional; sin ella, la web no puede pedirlos (409 entrada_no_configurada) y el trabajador no
# atiende pedidos. Debe existir, no estar bajo /mnt/ y NO ser ni estar dentro de
# GEPP_CARPETA_VIGILADA (ni al revés): la vigilada procesa sola y con una sola cámara. La leen la
# API y el trabajador y deben ver la misma ruta.
GEPP_CARPETA_ENTRADA=/datos/videos/pedidos

GEPP_FPS_OBJETIVO=5.0
# Fuente (tabla `fuente`) a la que pertenece la carpeta vigilada
GEPP_FUENTE_ID=1
# Intentos antes de dejar un video en `error`; después solo vuelve si alguien lo reprocesa
GEPP_MAXIMO_INTENTOS=3
# Detector falso con guion JSON, mientras no exista el modelo (PT-08)
GEPP_GUION_FALSO=tests/fixtures/guion_sin_casco.json
# Si ambos están, cada hallazgo escribe su aviso en el outbox (canal: correo|telegram|whatsapp|webhook)
GEPP_AVISO_CANAL=
GEPP_AVISO_DESTINATARIO=
# Sin GEPP_GUION_FALSO, el trabajador usa este modelo ONNX, con su .clases.json al lado
# (ver docs/operacion/modelo-onnx.md)
GEPP_MODELO_RUTA=/datos/modelos/rfdetr-n-epp-v1.onnx
GEPP_UMBRAL_CONFIANZA=0.25

# Notificaciones (ver ADR-008 y docs/operacion/alertas-telegram.md)
# Token del bot que entrega @BotFather. Es un SECRETO: solo en el .env, nunca en el repositorio.
GEPP_TELEGRAM_TOKEN=
# El chat que recibe: `make telegram-chat-id` lo muestra. Va en GEPP_AVISO_DESTINATARIO.
GEPP_DESPACHO_INTERVALO_S=5
GEPP_SMTP_URL=

# Vista en vivo del procesamiento (excepción de privacidad, ver 02-privacidad-y-cumplimiento.md).
# APAGADA por defecto: solo con 1 el trabajador escribe en GEPP_CARPETA_VIVO (memoria) un anillo de
# hasta 60 cuadros por video, <video_id>/<seq>_<pos_ms>.jpg, muestreados a GEPP_VIVO_FPS (también
# los que el modelo no analiza), nítidos y SIN tapar rostros (decisión de Edgar del 2026-10-09,
# ver ADR-006); solo los polígonos de privacidad van en negro. En los cuadros que el modelo no
# analiza, las cajas son las del análisis anterior. Se borra al terminar el intento, y al
# arrancar el trabajador se vacía la carpeta aunque la vista esté apagada (sin crearla). Solo para
# clientes dentro de la infraestructura controlada (ADR-010).
GEPP_VISTA_EN_VIVO=0
GEPP_CARPETA_VIVO=/dev/shm/gepp-vivo
# Cuadros por segundo de VIDEO (no de reloj) con que se escribe la vista (ritmo, no máximo).
# Positivo; si no, el trabajador no arranca. Con la vista prendida se decodifican los cuadros
# saltados que ese ritmo pide. No afecta al avance de la fila (2 s), que escribe en la base.
GEPP_VIVO_FPS=25
