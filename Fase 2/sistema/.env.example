# Copiar a .env y ajustar. El .env real NUNCA se versiona.
GEPP_BD_URL=postgresql+psycopg://gepp:gepp_dev@localhost:5432/gepp
GEPP_REDIS_URL=redis://localhost:6379/0

# Carpeta vigilada. Debe estar en el sistema de archivos de Linux:
# inotify NO funciona sobre /mnt/c en WSL2 — la llamada tiene éxito y nunca llega
# un evento. El sistema rechaza rutas bajo /mnt/ (ver ADR-005).
GEPP_CARPETA_VIGILADA=/datos/videos/entrada
GEPP_CARPETA_EVIDENCIA=/datos/evidencia

GEPP_FPS_OBJETIVO=5.0
# Fuente (tabla `fuente`) a la que pertenece la carpeta vigilada
GEPP_FUENTE_ID=1
# Detector falso con guion JSON, mientras no exista el modelo (PT-08)
GEPP_GUION_FALSO=tests/fixtures/guion_sin_casco.json
# Si ambos están, cada hallazgo escribe su aviso en el outbox (canal: correo|telegram|whatsapp|webhook)
GEPP_AVISO_CANAL=
GEPP_AVISO_DESTINATARIO=
GEPP_MODELO_RUTA=/datos/modelos/rfdetr-n-epp-v1.onnx

# Notificaciones (ver ADR-008)
GEPP_TELEGRAM_TOKEN=
GEPP_SMTP_URL=
