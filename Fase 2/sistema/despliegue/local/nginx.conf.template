# Plantilla: la imagen de nginx sustituye ${API_UPSTREAM} al arrancar (host:puerto de la API).
# Solo /api/ y /espejo/ salen de aquí. /metrics, /docs y /openapi.json no se exponen (no llevan
# autenticación o describen la API entera): quedan para dentro de la red.
#
# DOS `server` separados A PROPÓSITO: 8080 (proyector, token del bundle) y 8081 (la tailnet, por
# `tailscale serve`): ahí sin `Tailscale-User-Login` de la lista (DEMO_IDENTIDADES) todo es 403 y la API
# recibe el token de la persona, nunca el del bundle. Serve no pone la cabecera a dispositivos con
# etiqueta: ninguna puerta deja pasar con el token del bundle por faltar la cabecera.
# El mapa lo genera identidades.sh al arrancar (/etc/nginx/identidades.conf); si falta, nginx no arranca.
include /etc/nginx/identidades.conf;

upstream api_up {
    server ${API_UPSTREAM};
}

map $upstream_http_location $espejo_location {
    default "";
    "~^(?:https?://[^/]+)?/(?<resto>.*)$" "/espejo/$resto";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    set $authz_api $http_authorization;    # el espejo le pregunta a la API con el token del bundle
    include /etc/nginx/espejo.inc;

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 30s;
        # Nada de lo que pasa por aquí toca el disco del contenedor: los cuadros de la vista en
        # vivo son nítidos y solo pueden vivir en memoria (condición 4 de la vista en vivo).
        proxy_max_temp_file_size 0;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

server {
    listen 8081;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Antes de elegir location: sin persona conocida no pasa NADA (ni la web, ni /api/, ni /espejo/).
    if ($token_persona = "") {
        return 403;
    }

    set $authz_api "Bearer $token_persona";    # el espejo le pregunta a la API como esta persona
    include /etc/nginx/espejo.inc;

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Pisa el Authorization del navegador (el del bundle) con el de esta persona.
        proxy_set_header Authorization $authz_api;
        proxy_set_header Tailscale-User-Login "";
        proxy_set_header Tailscale-User-Name "";
        proxy_set_header Tailscale-User-Profile-Pic "";
        proxy_set_header Tailscale-Headers-Info "";
        proxy_read_timeout 30s;
        proxy_max_temp_file_size 0;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
