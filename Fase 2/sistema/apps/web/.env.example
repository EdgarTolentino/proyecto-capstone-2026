# Copiar a .env.local (ignorado por git) y ajustar.
# API real levantada con `make api` o `make demo-todo`. Sin esta variable, la web usa el mock de Prism en :4010.
VITE_API_URL=http://localhost:8000/api/v1
# Con qué cuenta entras. `demo` es el prevencionista de demostración; `admin`, el administrador.
# Las cuentas del equipo son la parte del correo antes de la arroba: mortega, lgrandon.
VITE_API_TOKEN=demo
