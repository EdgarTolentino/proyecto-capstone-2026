# Copiar a .env.development.local (ignorado por git) y ajustar. Ese archivo solo lo lee
# `npm run dev`: las pruebas y `vite build` no lo cargan, así que tu cuenta no termina en un bundle.
# API real levantada con `make api` o `make demo-todo`. Sin esta variable, la web usa el mock de Prism en :4010.
VITE_API_URL=http://localhost:8000/api/v1
# Con qué cuenta entras. `demo` es el prevencionista de demostración.
# Las cuentas del equipo son la parte del correo antes de la arroba: mortega (administrador), lgrandon (prevencionista).
VITE_API_TOKEN=demo
